{{ 'reviews-rail.css' | asset_url | stylesheet_tag }}

<section class="reviews">

  <div class="page-width">

    <h2>{{ section.settings.heading }}</h2>

    <div class="reviews__grid">

      {% for block in section.blocks %}

      <div class="review-card" {{ block.shopify_attributes }}>

        <p>"{{ block.settings.review }}"</p>

        <h4>{{ block.settings.author }}</h4>

      </div>

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Amazing quality!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "John Doe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Rail"
    }
  ]
}
{% endschema %}