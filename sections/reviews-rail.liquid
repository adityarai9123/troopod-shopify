{{ 'reviews-rail.css' | asset_url | stylesheet_tag }}
<section
  class="reviews"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <div class="page-width">

    <h2 class="reviews__title">
      {{ section.settings.heading }}
    </h2>

    <div class="reviews__grid">

      {% for block in section.blocks limit: 10 %}
      
      <div class="review-card" {{ block.shopify_attributes }}>

        <div
          class="review-card__rating"
          aria-label="{{ block.settings.rating }} out of 5 stars"
          style="color: #FFD700;"
        >
          {% for i in (1..block.settings.rating) %}
            ★
          {% endfor %}
        </div>

        <blockquote class="review-card__text">
          "{{ block.settings.review }}"
        </blockquote>

        <h4>{{ block.settings.author }}</h4>

      </div>

      

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Reviews Rail",
  
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
        {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Amazing quality!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "John Doe"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Reviews Rail",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}