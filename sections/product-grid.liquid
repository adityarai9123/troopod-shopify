{{ 'product-grid.css' | asset_url | stylesheet_tag }}

<section class="product-grid">

  <div class="page-width">

    <h2 class="product-grid__title">
      {{ section.settings.heading }}
    </h2>

    <div class="product-grid__items">

      {% for block in section.blocks %}

        <div class="product-card" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            {{
            block.settings.image
            | image_url: width:600
            | image_tag:
            loading:'lazy'
            }}
          {% endif %}

          <h3>{{ block.settings.title }}</h3>

          <p>{{ block.settings.price }}</p>

          <a href="{{ block.settings.link }}" class="product-card__button">
            View Product
          </a>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Coffee Mug"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$19.99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}