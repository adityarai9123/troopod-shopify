{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<section
  class="product-grid"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <div class="page-width">

    <h2 class="product-grid__title">
      {{ section.settings.heading }}
    </h2>

    <div class="product-grid__items">

      {% for block in section.blocks limit: 6 %}

        {% assign product = block.settings.product %}

        {% if product != blank %}
          <div {{ block.shopify_attributes }}>
            {% render 'product-card',
              product_card: product %}
          </div>
        {% endif %}

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}