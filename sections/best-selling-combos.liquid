{{ 'best-selling-combos.css' | asset_url | stylesheet_tag }}

<section
  class="combos"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    <h2 class="combos__title">
      {{ section.settings.heading }}
    </h2>

    <div class="combos__grid">

      {% for block in section.blocks limit: 6 %}

        {% assign product = block.settings.product %}

        {% if product != blank %}

          <div class="combo-card" {{ block.shopify_attributes }}>

            {{
              product.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1200',
                sizes: '(max-width:749px) 100vw, 50vw',
                alt: product.title
            }}

            <h3>{{ product.title }}</h3>

            <p>{{ product.price | money }}</p>

            <a
              href="{{ product.url }}"
              aria-label="View {{ product.title }}"
            >
              Buy Now
            </a>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Best Selling Combos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Selling Combos"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Best Selling Combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}