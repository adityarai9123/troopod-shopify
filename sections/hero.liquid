{{ 'hero.css' | asset_url | stylesheet_tag }}

<section
  class="hero"
  {% if section.settings.background_image != blank %}
    style="background-image:url('{{ section.settings.background_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="hero__overlay"></div>

  <div class="hero__container">

    <div class="hero__content">

      <p class="hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h1 class="hero__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="hero__description">
        {{ section.settings.description }}
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="hero__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

    <div class="hero__image">

      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image
        | image_url: width:800
        | image_tag:
        loading:'lazy',
        class:'hero__product-image'
        }}  
      {% endif %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ASSIGNMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Take a prototype homepage live on Shopify"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Turn it into production sections a merchant's marketing team can run without a developer."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Download the file"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}